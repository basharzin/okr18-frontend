# Copy to .env to run on your PC (npm run dev). Never commit .env. No secrets here:
# the Turnstile secret is read from Secrets Manager.
PORT=3000
AWS_PROFILE=floci
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# From infra/okr18-vars.sh
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=
COGNITO_JWKS_URI=
TURNSTILE_SECRET_ARN=
# Leave empty on a PC to keep lockout counts in memory
LOGIN_ATTEMPTS_TABLE=
ALLOW_HTTP_JWKS=true
CORS_ORIGINS=http://localhost:8080
